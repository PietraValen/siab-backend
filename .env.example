# Copie este arquivo para ".env" (NÃO versionar o .env real) e preencha
# com os dados reais do seu serviço MySQL no Aiven.

DB_HOST=seu-servico.aivencloud.com
DB_PORT=12345
DB_NAME=defaultdb
DB_USER=avnadmin
DB_PASSWORD=troque-pela-senha-real-do-aiven

# Obrigatório: a aplicação não sobe sem ele (nem com este valor de exemplo).
# Gere um aleatório com: openssl rand -base64 48
JWT_SECRET=troque-por-uma-string-aleatoria-de-pelo-menos-32-caracteres

SERVER_PORT=8080
