# Copie este arquivo para ".env" (NÃO versionar o .env real) e preencha
# com os dados reais do seu serviço MySQL no Aiven.

DB_HOST=seu-servico.aivencloud.com
DB_PORT=12345
DB_NAME=defaultdb
DB_USER=avnadmin
DB_PASSWORD=troque-pela-senha-real-do-aiven

JWT_SECRET=troque-por-uma-string-aleatoria-de-pelo-menos-32-caracteres

SERVER_PORT=8080

# --- Segurança (docs/seguranca.md) ---------------------------------------
# Chaves híbridas (clássica + pós-quântica). OBRIGATÓRIAS: sem elas a API não
# sobe. Gere uma vez com:  java scripts/GerarChaves.java
# e guarde fora do repositório. Perder SIAB_CHAVES_CIFRA = perder a biometria.
SIAB_CHAVES_CIFRA=
SIAB_CHAVES_ASSINATURA=

# Origens do front-end autorizadas pelo CORS (separadas por vírgula).
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Cookie de sessão só por HTTPS. Use false apenas em desenvolvimento sem TLS.
COOKIE_SECURE=true
# Validade do token do painel (ms). Padrão: 30 min.
JWT_EXPIRATION_MS=1800000
# "native" quando a API roda atrás do Caddy/nginx (deploy/), para o rate
# limit enxergar o IP real do cliente. Deixe "none" sem proxy na frente.
FORWARD_HEADERS_STRATEGY=none

# TLS do MySQL. REQUIRED cifra mas não valida o certificado; VERIFY_IDENTITY
# valida também o host (recomendado, precisa da CA do Aiven, ver docs).
DB_SSL_MODE=REQUIRED
# Ex.: &trustCertificateKeyStoreUrl=file:/certs/aiven-ca.jks&trustCertificateKeyStorePassword=changeit
DB_SSL_EXTRA=

# Anti-spoofing por piscada (vários frames). false só para testes com foto parada.
LIVENESS_EXIGIR_PISCADA=true
