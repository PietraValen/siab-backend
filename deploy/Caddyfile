# Proxy reverso TLS do SIAB (seção 4.2 do roteiro em docs/seguranca.md).
#
# Um único domínio na frente dos dois serviços: /api/* vai para o back-end
# e o resto para o front-end. Assim o navegador vê uma origem só — o cookie
# HttpOnly do painel é same-site e o CORS deixa de ser necessário.
#
# Troca de chaves pós-quântica híbrida: o Caddy (2.10+, Go 1.24+) negocia
# X25519MLKEM768 (X25519 + ML-KEM-768, FIPS 203) no TLS 1.3 com navegadores
# atuais. A diretiva "curves" abaixo deixa isso explícito e mantém X25519
# puro como alternativa para clientes antigos.
#
# Uso: troque {$SIAB_DOMINIO} pelo domínio real (ou exporte a variável) e
# rode com "caddy run --config deploy/Caddyfile". Com um domínio público, o
# Caddy emite o certificado sozinho (Let's Encrypt).

{$SIAB_DOMINIO:siab.localhost} {
	tls {
		protocols tls1.3
		curves x25519mlkem768 x25519
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		-Server
	}

	@api path /api/* /actuator/health
	handle @api {
		# O back-end precisa de FORWARD_HEADERS_STRATEGY=framework para ler o
		# IP real do cliente (rate limiting e auditoria) dos headers abaixo.
		reverse_proxy {$SIAB_BACKEND:localhost:8080}
	}

	handle {
		reverse_proxy {$SIAB_FRONTEND:localhost:3000}
	}
}
